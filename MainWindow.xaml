<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="SystemCompanion.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="{StaticResource Ink900Brush}">
        <!--  Soft colour wash so the window does not read as flat black.  -->
        <Grid.ChildrenTransitions>
            <TransitionCollection>
                <EntranceThemeTransition />
            </TransitionCollection>
        </Grid.ChildrenTransitions>

        <Ellipse
            Width="900"
            Height="900"
            Margin="-180,-420,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Opacity="0.20">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Offset="0" Color="#FF1E6FA8" />
                    <GradientStop Offset="1" Color="#00070A0F" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Ellipse
            Width="820"
            Height="820"
            Margin="0,0,-220,-360"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Opacity="0.18">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Offset="0" Color="#FF4B3A8C" />
                    <GradientStop Offset="1" Color="#00070A0F" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <NavigationView
            x:Name="Nav"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            OpenPaneLength="264"
            PaneDisplayMode="Left"
            SelectionChanged="Nav_SelectionChanged">

            <NavigationView.PaneHeader>
                <StackPanel Margin="4,18,0,14" Spacing="2">
                    <TextBlock
                        Style="{StaticResource EyebrowText}"
                        Text="SYSTEM COMPANION" />
                    <TextBlock
                        FontFamily="Segoe UI Variable Display"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextHiBrush}"
                        Text="This computer, explained" />
                </StackPanel>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="BIOS — right now" Tag="bios">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Windows — right now" Tag="windows">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE770;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="What could be better" Tag="improve">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE945;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="What changed" Tag="history">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <StackPanel Margin="10,0,10,18" Spacing="6">
                    <Border Style="{StaticResource SoftCard}" Padding="12">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource EyebrowText}" Text="LAST SCANNED" />
                            <TextBlock
                                x:Name="LastScannedText"
                                Style="{StaticResource BodyText}"
                                FontSize="12" />
                            <TextBlock
                                x:Name="BiosFooterText"
                                Style="{StaticResource CaptionText}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </NavigationView.PaneFooter>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Drag region doubles as a slim status strip. The actions sit outside it
                      so the drag region never swallows their clicks.  -->
                <Grid
                    Grid.Row="0"
                    MinHeight="48"
                    ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid
                        x:Name="TitleBarDragRegion"
                        Grid.Column="0"
                        Background="Transparent">
                        <!--  A star column for the subtitle lets it trim with an ellipsis
                              instead of being cut off by the drag region's edge.  -->
                        <Grid
                            Margin="28,0,0,0"
                            VerticalAlignment="Center"
                            ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.Column="0"
                                Width="8"
                                Height="8"
                                Background="{StaticResource AccentGradient}"
                                CornerRadius="4" />
                            <TextBlock
                                x:Name="HeaderTitle"
                                Grid.Column="1"
                                Style="{StaticResource CaptionText}"
                                Text="BIOS — right now" />
                            <TextBlock
                                Grid.Column="2"
                                Style="{StaticResource CaptionText}"
                                Text="·" />
                            <TextBlock
                                x:Name="HeaderSubtitle"
                                Grid.Column="3"
                                Style="{StaticResource CaptionText}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </Grid>
                    </Grid>

                    <StackPanel
                        Grid.Column="1"
                        Margin="0,0,28,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="12">
                        <!--  Shown only when the two newest readings differ.  -->
                        <HyperlinkButton
                            x:Name="ChangesLink"
                            Padding="4,2"
                            Click="Changes_Click"
                            FontSize="12"
                            Foreground="{StaticResource CyanBrush}"
                            Visibility="Collapsed" />
                        <!--  The rescan bar lives here so it is reachable from every screen.  -->
                        <ContentControl x:Name="ScanBarHost" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <Frame
                    x:Name="ContentFrame"
                    Grid.Row="1"
                    Margin="28,0,28,24" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
