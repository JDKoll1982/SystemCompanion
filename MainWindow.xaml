<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="SystemCompanion.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="{StaticResource Ink900Brush}">
        <!--  Soft colour wash so the window does not read as flat black.  -->
        <Grid.ChildrenTransitions>
            <TransitionCollection>
                <EntranceThemeTransition />
            </TransitionCollection>
        </Grid.ChildrenTransitions>

        <Ellipse
            Width="900"
            Height="900"
            Margin="-180,-420,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Opacity="0.20">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Offset="0" Color="#FF1E6FA8" />
                    <GradientStop Offset="1" Color="#00070A0F" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Ellipse
            Width="820"
            Height="820"
            Margin="0,0,-220,-360"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Opacity="0.18">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Offset="0" Color="#FF4B3A8C" />
                    <GradientStop Offset="1" Color="#00070A0F" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <NavigationView
            x:Name="Nav"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            OpenPaneLength="264"
            PaneDisplayMode="Left"
            SelectionChanged="Nav_SelectionChanged">

            <NavigationView.PaneHeader>
                <StackPanel Margin="4,18,0,14" Spacing="2">
                    <TextBlock
                        Style="{StaticResource EyebrowText}"
                        Text="SYSTEM COMPANION" />
                    <TextBlock
                        FontFamily="Segoe UI Variable Display"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextHiBrush}"
                        Text="This computer, explained" />
                </StackPanel>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="BIOS — right now" Tag="bios">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Windows — right now" Tag="windows">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE770;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="What could be better" Tag="improve">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE945;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <StackPanel Margin="10,0,10,18" Spacing="6">
                    <Border Style="{StaticResource SoftCard}" Padding="12">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource EyebrowText}" Text="LAST SCANNED" />
                            <TextBlock
                                x:Name="LastScannedText"
                                Style="{StaticResource BodyText}"
                                FontSize="12" />
                            <TextBlock
                                x:Name="BiosFooterText"
                                Style="{StaticResource CaptionText}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </NavigationView.PaneFooter>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Drag region doubles as a slim status strip.  -->
                <Grid
                    x:Name="TitleBarDragRegion"
                    Grid.Row="0"
                    Background="Transparent">
                    <StackPanel
                        Margin="28,0,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="10">
                        <Border
                            Width="8"
                            Height="8"
                            Background="{StaticResource AccentGradient}"
                            CornerRadius="4" />
                        <TextBlock
                            x:Name="HeaderTitle"
                            Style="{StaticResource CaptionText}"
                            Text="BIOS — right now" />
                        <TextBlock Style="{StaticResource CaptionText}" Text="·" />
                        <TextBlock
                            x:Name="HeaderSubtitle"
                            Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </Grid>

                <Frame
                    x:Name="ContentFrame"
                    Grid.Row="1"
                    Margin="28,0,28,24" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
