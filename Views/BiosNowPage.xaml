<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SystemCompanion.Views.BiosNowPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SystemCompanion.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SystemCompanion.Models"
    mc:Ignorable="d"
    SizeChanged="BiosPage_SizeChanged">

    <ScrollViewer x:Name="PageScroll" Padding="0,0,8,0" VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="1180"
            HorizontalAlignment="Stretch"
            Spacing="18">

            <!--  Hero  -->
            <Border Style="{StaticResource HeroCard}">
                <StackPanel Spacing="18">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource EyebrowText}" Text="SAVED IN THE BIOS" />
                        <TextBlock Style="{StaticResource DisplayText}" Text="Your firmware settings, in plain words" />
                        <TextBlock
                            MaxWidth="760"
                            Style="{StaticResource BodyText}"
                            Text="The motherboard keeps your settings in a small file. This is what that file says right now — no technical knowledge needed to read it." />
                    </StackPanel>

                    <!--  Pills scroll sideways rather than clipping when the board name is long
                          or the window is narrow.  -->
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Auto"
                        HorizontalScrollMode="Auto"
                        VerticalScrollBarVisibility="Disabled"
                        VerticalScrollMode="Disabled">
                        <StackPanel
                            x:Name="PillStack"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Border
                                HorizontalAlignment="Left" Padding="12,6"
                                Background="#1A3DDC97"
                                BorderBrush="#553DDC97"
                                BorderThickness="1"
                                CornerRadius="14">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon
                                        FontSize="12"
                                        Foreground="{StaticResource MintBrush}"
                                        Glyph="&#xE73E;" />
                                    <TextBlock
                                        Style="{StaticResource PillText}"
                                        Foreground="{StaticResource MintBrush}"
                                        Text="{x:Bind ViewModel.ValidityText}" />
                                </StackPanel>
                            </Border>
                            <Border
                                HorizontalAlignment="Left" Padding="12,6"
                                Background="#14FFFFFF"
                                BorderBrush="#22FFFFFF"
                                BorderThickness="1"
                                CornerRadius="14">
                                <TextBlock Style="{StaticResource PillText}" Text="{x:Bind ViewModel.BiosVersion}" />
                            </Border>
                            <Border
                                HorizontalAlignment="Left" Padding="12,6"
                                Background="#14FFFFFF"
                                BorderBrush="#22FFFFFF"
                                BorderThickness="1"
                                CornerRadius="14">
                                <TextBlock Style="{StaticResource PillText}" Text="{x:Bind ViewModel.Board}" />
                            </Border>
                            <Border
                                HorizontalAlignment="Left" Padding="12,6"
                                Background="#14FFFFFF"
                                BorderBrush="#22FFFFFF"
                                BorderThickness="1"
                                CornerRadius="14">
                                <TextBlock Style="{StaticResource PillText}" Text="{x:Bind ViewModel.SavedLine}" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!--  Firmware mismatch: shown instead of confident wrong names  -->
            <Border Style="{StaticResource Card}" Visibility="{x:Bind ViewModel.HasFirmwareWarning}">
                <StackPanel Spacing="6">
                    <TextBlock
                        Style="{StaticResource EyebrowText}"
                        Foreground="{StaticResource AmberBrush}"
                        Text="FIRMWARE DOES NOT MATCH" />
                    <TextBlock
                        MaxWidth="820"
                        Style="{StaticResource BodyText}"
                        Text="{x:Bind ViewModel.FirmwareWarning}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!--  Headline tiles  -->
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Headline}" Visibility="{x:Bind ViewModel.ShowsDecodedValues}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        ItemsStretch="Fill"
                        MinColumnSpacing="14"
                        MinItemWidth="230"
                        MinRowSpacing="14" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:FactTile">
                        <Border
                            MinHeight="150"
                            Style="{StaticResource Card}"
                            Padding="20">
                            <StackPanel Spacing="6">
                                <Border
                                    Width="30"
                                    Height="4"
                                    HorizontalAlignment="Left"
                                    Background="{x:Bind AccentBrush}"
                                    CornerRadius="2" />
                                <TextBlock
                                    Margin="0,6,0,0"
                                    Style="{StaticResource EyebrowText}"
                                    Foreground="{StaticResource TextLoBrush}"
                                    Text="{x:Bind Label}" />
                                <TextBlock
                                    FontFamily="Segoe UI Variable Display"
                                    FontSize="24"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TextHiBrush}"
                                    Text="{x:Bind Value}"
                                    TextLineBounds="Tight" />
                                <TextBlock
                                    MaxWidth="300"
                                    Style="{StaticResource CaptionText}"
                                    Text="{x:Bind Plain}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <!--  Detail sections  -->
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Sections}" Visibility="{x:Bind ViewModel.ShowsDecodedValues}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="16" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:SectionCard">
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="4">
                                <StackPanel
                                    Margin="0,0,0,10"
                                    Orientation="Horizontal"
                                    Spacing="10">
                                    <Border
                                        Width="32"
                                        Height="32"
                                        Background="#1A4CD7F0"
                                        CornerRadius="9">
                                        <FontIcon
                                            FontSize="14"
                                            Foreground="{StaticResource CyanBrush}"
                                            Glyph="{x:Bind Icon}" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource H2Text}" Text="{x:Bind Title}" />
                                        <TextBlock
                                            Style="{StaticResource CaptionText}"
                                            Text="{x:Bind Subtitle}"
                                            Visibility="{x:Bind SubtitleVisibility}" />
                                    </StackPanel>
                                </StackPanel>

                                <ItemsRepeater ItemsSource="{x:Bind Rows}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="0" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="models:InfoRow">
                                            <Border BorderBrush="#1424303F" BorderThickness="0,0,0,1">
                                                <Grid Padding="0,12,0,12" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="4" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border
                                                    Grid.Column="0"
                                                    Width="3"
                                                    Margin="0,2,0,2"
                                                    Background="{x:Bind AccentBrush}"
                                                    CornerRadius="2"
                                                    Opacity="0.9"
                                                    Visibility="{x:Bind ChangedVisibility}" />

                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock
                                                        FontSize="13"
                                                        Foreground="{StaticResource TextMidBrush}"
                                                        Text="{x:Bind Name}"
                                                        TextWrapping="Wrap" />
                                                    <TextBlock
                                                        MaxWidth="620"
                                                        Style="{StaticResource CaptionText}"
                                                        Text="{x:Bind Plain}"
                                                        Visibility="{x:Bind PlainVisibility}" />
                                                </StackPanel>

                                                <TextBlock
                                                    Grid.Column="2"
                                                    MaxWidth="300"
                                                    FontFamily="Segoe UI Variable Text"
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource TextHiBrush}"
                                                    Text="{x:Bind Value}"
                                                    TextAlignment="Right"
                                                    TextWrapping="Wrap" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <Border Style="{StaticResource SoftCard}" Margin="0,4,0,8">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource EyebrowText}" Foreground="{StaticResource TextLoBrush}" Text="ABOUT THIS FILE" />
                    <TextBlock Style="{StaticResource BodyText}" FontSize="12.5">
                        <Run Text="Everything above was read from " />
                        <Run FontWeight="SemiBold" Text="{x:Bind ViewModel.FileName}" />
                        <Run Text=" (" />
                        <Run Text="{x:Bind ViewModel.SizeText}" />
                        <Run Text=", " />
                        <Run Text="{x:Bind ViewModel.VariableText}" />
                        <Run Text="). " />
                        <Run Text="{x:Bind ViewModel.ChangedText}" />
                        <Run Text=". The built-in integrity check reports " />
                        <Run FontWeight="SemiBold" Text="{x:Bind ViewModel.Checksum}" />
                        <Run Text="." />
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
