<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SystemCompanion.Views.ImprovementsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SystemCompanion.Models"
    mc:Ignorable="d"
    SizeChanged="ImprovementsPage_SizeChanged">

    <ScrollViewer x:Name="PageScroll" Padding="0,0,8,0" VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="1560"
            HorizontalAlignment="Stretch"
            Spacing="18">

            <!--  Hero  -->
            <Border Style="{StaticResource HeroCard}">
                <Grid ColumnSpacing="28" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource EyebrowText}" Text="WHAT COULD BE BETTER" />
                        <TextBlock Style="{StaticResource DisplayText}" Text="{x:Bind ViewModel.HeadlineValue}" />
                        <TextBlock
                            MaxWidth="720"
                            Style="{StaticResource BodyText}"
                            Text="{x:Bind ViewModel.HeadlinePlain}" />

                        <StackPanel
                            Margin="0,10,0,0"
                            Orientation="Horizontal"
                            Spacing="18">
                            <StackPanel>
                                <TextBlock
                                    FontFamily="Segoe UI Variable Display"
                                    FontSize="22"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource AmberBrush}"
                                    Text="{x:Bind ViewModel.WorthDoingCount}" />
                                <TextBlock Style="{StaticResource CaptionText}" Text="worth doing" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock
                                    FontFamily="Segoe UI Variable Display"
                                    FontSize="22"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource CyanBrush}"
                                    Text="{x:Bind ViewModel.OptionalCount}" />
                                <TextBlock Style="{StaticResource CaptionText}" Text="optional" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock
                                    FontFamily="Segoe UI Variable Display"
                                    FontSize="22"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TextMidBrush}"
                                    Text="{x:Bind ViewModel.CheckCount}" />
                                <TextBlock Style="{StaticResource CaptionText}" Text="look yourself" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock
                                    FontFamily="Segoe UI Variable Display"
                                    FontSize="22"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource MintBrush}"
                                    Text="{x:Bind ViewModel.AlreadyGoodCount}" />
                                <TextBlock Style="{StaticResource CaptionText}" Text="already good" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel
                        x:Name="OverallPanel"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="6">
                        <Border
                            Padding="18,14"
                            Background="#12FFFFFF"
                            BorderBrush="#22FFFFFF"
                            BorderThickness="1"
                            CornerRadius="16">
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource EyebrowText}" Foreground="{StaticResource TextLoBrush}" Text="OVERALL" />
                                <TextBlock
                                    FontFamily="Segoe UI Variable Display"
                                    FontSize="17"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TextHiBrush}"
                                    Text="{x:Bind ViewModel.ProgressText}"
                                    TextWrapping="Wrap"
                                    MaxWidth="220" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Filter chips scroll sideways rather than clipping on a narrow window.  -->
            <StackPanel Spacing="6">
                <ScrollViewer
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Auto"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="0">
                        <ToggleButton
                            x:Name="ChipAll"
                            Click="Chip_Click"
                            Content="Everything"
                            IsChecked="True"
                            Style="{StaticResource ChipButton}"
                            Tag="All" />
                        <ToggleButton
                            x:Name="ChipProgramming"
                            Click="Chip_Click"
                            Content="Programming"
                            Style="{StaticResource ChipButton}"
                            Tag="Programming" />
                        <ToggleButton
                            x:Name="ChipGaming"
                            Click="Chip_Click"
                            Content="Gaming"
                            Style="{StaticResource ChipButton}"
                            Tag="Gaming" />
                        <ToggleButton
                            x:Name="ChipAi"
                            Click="Chip_Click"
                            Content="AI work"
                            Style="{StaticResource ChipButton}"
                            Tag="Ai" />
                        <ToggleButton
                            x:Name="ChipEveryday"
                            Click="Chip_Click"
                            Content="Everyday"
                            Style="{StaticResource ChipButton}"
                            Tag="Everyday" />
                    </StackPanel>
                </ScrollViewer>

                <TextBlock
                    Style="{StaticResource CaptionText}"
                    Text="{x:Bind ViewModel.VisibleText, Mode=OneWay}" />
            </StackPanel>

            <!--  Suggestion cards  -->
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Items}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        ItemsStretch="Fill"
                        MinColumnSpacing="16"
                        MinItemWidth="470"
                        MinRowSpacing="16" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:SuggestionCard">
                        <Border
                            Style="{StaticResource Card}"
                            Padding="22">
                            <StackPanel Spacing="12">

                                <!--  status + goal  -->
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Grid.Column="0"
                                        Padding="10,5"
                                        Background="{x:Bind AccentTint}"
                                        BorderBrush="{x:Bind AccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon
                                                FontSize="11"
                                                Foreground="{x:Bind AccentBrush}"
                                                Glyph="{x:Bind StateGlyph}" />
                                            <TextBlock
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="{x:Bind AccentBrush}"
                                                Text="{x:Bind StateLabel}" />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource EyebrowText}"
                                        Foreground="{StaticResource TextLoBrush}"
                                        Text="{x:Bind GoalLabel}" />
                                </Grid>

                                <TextBlock
                                    FontFamily="Segoe UI Variable Display"
                                    FontSize="17"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TextHiBrush}"
                                    Text="{x:Bind Title}"
                                    TextLineBounds="Tight"
                                    TextWrapping="Wrap" />

                                <TextBlock Style="{StaticResource BodyText}" Text="{x:Bind Summary}" />

                                <!--  current -> target  -->
                                <Border
                                    Padding="12,9"
                                    Background="{StaticResource Ink800Brush}"
                                    BorderBrush="{StaticResource StrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock
                                            Style="{StaticResource CaptionText}"
                                            Text="now" />
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource TextMidBrush}"
                                            Text="{x:Bind Current}"
                                            TextWrapping="Wrap" />
                                        <FontIcon
                                            FontSize="10"
                                            Foreground="{StaticResource TextLoBrush}"
                                            Glyph="&#xE72A;" />
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource TextHiBrush}"
                                            Text="{x:Bind Target}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!--  why  -->
                                <StackPanel Spacing="3">
                                    <TextBlock
                                        Style="{StaticResource EyebrowText}"
                                        Foreground="{StaticResource TextLoBrush}"
                                        Text="WHY IT HELPS" />
                                    <TextBlock Style="{StaticResource BodyText}" FontSize="12.5" Text="{x:Bind Why}" />
                                </StackPanel>

                                <!--  how  -->
                                <StackPanel Spacing="3">
                                    <TextBlock
                                        Style="{StaticResource EyebrowText}"
                                        Foreground="{StaticResource TextLoBrush}"
                                        Text="HOW TO DO IT" />
                                    <TextBlock Style="{StaticResource BodyText}" FontSize="12.5" Text="{x:Bind HowTo}" />
                                </StackPanel>

                                <!--  footer  -->
                                <Border Style="{StaticResource RowDivider}" />
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        Style="{StaticResource CaptionText}"
                                        Foreground="{StaticResource TextMidBrush}"
                                        Text="{x:Bind Benefit}" />

                                    <StackPanel
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="5"
                                        Visibility="{x:Bind RestartVisibility}">
                                        <FontIcon
                                            FontSize="10"
                                            Foreground="{StaticResource AmberBrush}"
                                            Glyph="&#xE72C;" />
                                        <TextBlock Style="{StaticResource CaptionText}" Text="needs restart" />
                                    </StackPanel>

                                    <Border
                                        Grid.Column="2"
                                        Padding="8,3"
                                        Background="{StaticResource Ink600Brush}"
                                        CornerRadius="8">
                                        <TextBlock
                                            Style="{StaticResource CaptionText}"
                                            Foreground="{StaticResource TextMidBrush}"
                                            Text="{x:Bind Risk}" />
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <Border Style="{StaticResource SoftCard}" Margin="0,4,0,8">
                <StackPanel Spacing="5">
                    <TextBlock Style="{StaticResource EyebrowText}" Foreground="{StaticResource TextLoBrush}" Text="BEFORE YOU CHANGE ANYTHING" />
                    <TextBlock
                        Style="{StaticResource BodyText}"
                        FontSize="12.5"
                        Text="Nothing on this page has been applied. Each card tells you what it is worth, how confident you can be, and whether a restart is needed. Change one thing at a time so you always know what caused a difference — and if a change makes the machine unstable, set it back to how it was." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
