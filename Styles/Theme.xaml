<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Palette: deep ink surfaces with a cyan-to-violet accent.  -->
    <Color x:Key="Ink900">#FF070A0F</Color>
    <Color x:Key="Ink800">#FF0B1017</Color>
    <Color x:Key="Ink700">#FF121924</Color>
    <Color x:Key="Ink600">#FF18212E</Color>
    <Color x:Key="StrokeColor">#FF24303F</Color>
    <Color x:Key="CyanColor">#FF4CD7F0</Color>
    <Color x:Key="VioletColor">#FF8B7CFF</Color>
    <Color x:Key="MintColor">#FF3DDC97</Color>
    <Color x:Key="AmberColor">#FFFFC65C</Color>
    <Color x:Key="CoralColor">#FFFF7A85</Color>

    <SolidColorBrush x:Key="Ink900Brush" Color="{StaticResource Ink900}" />
    <SolidColorBrush x:Key="Ink800Brush" Color="{StaticResource Ink800}" />
    <SolidColorBrush x:Key="Ink700Brush" Color="{StaticResource Ink700}" />
    <SolidColorBrush x:Key="Ink600Brush" Color="{StaticResource Ink600}" />
    <SolidColorBrush x:Key="StrokeBrush" Color="{StaticResource StrokeColor}" />
    <SolidColorBrush x:Key="CyanBrush" Color="{StaticResource CyanColor}" />
    <SolidColorBrush x:Key="VioletBrush" Color="{StaticResource VioletColor}" />
    <SolidColorBrush x:Key="MintBrush" Color="{StaticResource MintColor}" />
    <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource AmberColor}" />
    <SolidColorBrush x:Key="CoralBrush" Color="{StaticResource CoralColor}" />

    <SolidColorBrush x:Key="TextHiBrush" Color="#FFEEF4FB" />
    <SolidColorBrush x:Key="TextMidBrush" Color="#FFA9B7C9" />
    <SolidColorBrush x:Key="TextLoBrush" Color="#FF74839A" />

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="{StaticResource CyanColor}" />
        <GradientStop Offset="1" Color="{StaticResource VioletColor}" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FF0F2C42" />
        <GradientStop Offset="0.55" Color="#FF151C33" />
        <GradientStop Offset="1" Color="#FF241B3A" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardSheen" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#14FFFFFF" />
        <GradientStop Offset="1" Color="#00FFFFFF" />
    </LinearGradientBrush>

    <!--  Typography  -->
    <Style x:Key="EyebrowText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="180" />
        <Setter Property="Foreground" Value="{StaticResource CyanBrush}" />
        <Setter Property="TextLineBounds" Value="Tight" />
    </Style>

    <Style x:Key="DisplayText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextHiBrush}" />
        <Setter Property="TextLineBounds" Value="Tight" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="IsTextSelectionEnabled" Value="True" />
    </Style>

    <Style x:Key="H1Text" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextHiBrush}" />
        <Setter Property="TextLineBounds" Value="Tight" />
    </Style>

    <Style x:Key="H2Text" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextHiBrush}" />
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{StaticResource TextMidBrush}" />
        <Setter Property="LineHeight" Value="21" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="IsTextSelectionEnabled" Value="True" />
    </Style>

    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource TextLoBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="MonoValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Cascadia Mono,Consolas" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource TextHiBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="IsTextSelectionEnabled" Value="True" />
    </Style>

    <!--  Surfaces  -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Ink700Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="22" />
    </Style>

    <Style x:Key="SoftCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Ink800Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="HeroCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource HeroGradient}" />
        <Setter Property="BorderBrush" Value="#33FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="Padding" Value="30,26,30,26" />
    </Style>

    <!--  Small pill used for status and metadata  -->
    <Style x:Key="PillText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextHiBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ChipButton" TargetType="ToggleButton">
        <Setter Property="Background" Value="{StaticResource Ink700Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource TextMidBrush}" />
    </Style>

    <Style x:Key="RowDivider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{StaticResource StrokeBrush}" />
        <Setter Property="Margin" Value="0,10,0,10" />
        <Setter Property="Opacity" Value="0.7" />
    </Style>

</ResourceDictionary>
